LLAMA_URL=http://192.168.10.245:8080
LLAMA_MODEL=gemma-4-e4b
LLAMA_TIMEOUT_SECONDS=180
SEARXNG_URL=http://searx.bp:8080
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
MAX_TOOL_LOOPS=5
SEARCH_MAX_RESULTS=10
FETCH_TIMEOUT_SECONDS=15

# Providers file (default: providers.yaml next to proxy.py).
# Without it, only LLAMA_URL / LLAMA_MODEL above are used.
# PROVIDERS_FILE=/opt/llm-proxy/providers.yaml

# API keys for external providers (names referenced by api_key_env in providers.yaml)
# OPENROUTER_API_KEY=
# FREEPROXY_API_KEY=

# Dev only: auto-reload on code change
RELOAD=false

# Admin panel (same process, separate port; 0 disables it)
ADMIN_PORT=8002
# SESSION_TTL_HOURS=168
# PANEL_TZ=Asia/Tehran
# Request log (metadata only) and provider health probe
# STATS_DB=/opt/llm-proxy/data/stats.db
# STATS_RETENTION_DAYS=90
# HEALTH_PROBE_SECONDS=300
